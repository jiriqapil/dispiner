# ==============================================================================
# === SYSTEM LAUNCH MODE ===
SUBMIT_MODE=pcmono
                          #   pcmono    -> Sequential foreground execution on current machine
                          #   pcpara    -> Parallel foreground  execution (background execution in developement)
                          #   hpc       -> Isolated OpenPBS submission inside automated GHCR container
# ==============================================================================
# === PATHS:  DEMO RUN PRESET (DEFAULT) ===
INPUT_DIR=./demo/input                          # Base input directory for demo dataset
OUTPUT_DIR=./demo/output                        # Base output directory for demo dataset
# === PRODUCTION OVERRIDES (UNCOMMENT TO USE) ===
# OUTPUT_DIR=/yourstorage/project/OUTPUT                       # Target destination directory
# TASK_LIST=/yourstorage/project/task_list.csv                 # Master task list CSV manifest
# MSEED_PATH=/yourstorage/project/MSEED/MSEED.tar              # Path to *.mseed folder OR MSEED.tar
# STATIONS_PATH=/yourstorage/prject/META/stations.csv          # Station metadata CSV file
# ETOPO_NC=None        # Topo netCDF grid file (or "None")
# QGIS_DIR=None        # QGIS layers directory (Set to "None" for basic boundaries; custom maps optimized in MAP_STYLE=Private for Central Europe
# ==============================================================================
# === PC/HPC RESOURCES ALLOCATION & BATCH WORKLOAD SETTINGS ===
# NTASKS_IN_BATCH=50   # Number of tasks per batch (e.g. 1000, ignored in pcpara mode)
# CPUS_PC=2            # Options: An integer (e.g., 1, 2, 4, or MAX to use all hardware cores, ignored in pcmono mode)
# CPUS_HPC=1           # CPUs per HPC node
# MEMORY=16gb          # Memory allocation per HPC batch
# WALLTIME=01:00:00    # Max runtime per HPC batch
# PBS_COMPETE_MAX=5    # Max concurrent PBS jobs allowed per subdata wave
# ==============================================================================
# === ALGORITHMIC SCHEME PRESET ===
ALGORITHM_SCHEME=HALIBUT
                          # Options:
                          #   HALIBUT*           -> Butterworth (1/4 octave) + Anchor Harmonization (True)
                          #   CONVENTIONAL_GAUSS -> Gaussian (alpha=50.0) + Anchor Harmonization (False)
                          #   CUSTOM             -> Manual override using low-level parameters below

# === MANUAL OVERRIDES (Active ONLY when ALGORITHM_SCHEME=CUSTOM) ===
# MULTIFILTER_TYPE=butterworth     # Options: butterworth* | gaussian
# BANDWIDTH_ALPHA=50.0             # Gaussian width parameter (e.g. 50.0* for Dziewonski default [alpha = pi * B], 20.0 for wider)
# BANDWIDTH_OCTAVE=4               # Butterworth octave fractio (e.g. 4* for 1/4th octave, 6 for 1/6th octave)
# ANCHOR_HARMONISATION=true        # Options: true* | false
# CROSSVALIDATION=true             # Options: true* | false
# ==============================================================================
# === MAP VISUALISATION & FIGURE STYLING ===
MAP_STYLE=Private              # Options: Default | Private
USE_QGIS=true                  # Options: true | false (toggles tectonic layers in Private mode)
IMAGE_QUALITY=Publish          # Options: Preview | Publish (toggles resolution 96dpi or 300dpi)
# ==============================================================================
# Note: Values marked with * indicate built-in defaults
